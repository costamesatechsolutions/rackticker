[Unit]
Description=Check RackTicker's installed files and repair a damaged install
# Not ordered before rackticker.service: repairing restarts it, and waiting on each
# other would hang both.
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/rackticker/current/deploy/rackticker-update.py heal
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
