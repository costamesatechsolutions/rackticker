[Unit]
Description=Install the RackTicker update the web page asked for
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/rackticker/current/deploy/rackticker-update.py update
TimeoutStartSec=20min
# Updates compile and install; keep them out of the display's way.
Nice=19
IOSchedulingClass=idle
MemoryMax=320M
OOMScoreAdjust=500
