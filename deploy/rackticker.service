[Unit]
Description=RackTicker local matrix display and control interface
Requires=rackticker-matrix.service
After=network.target rackticker-matrix.service
# Crashing again and again (say, after an update that passed its first minute):
# go back to the previous version.
StartLimitIntervalSec=600
StartLimitBurst=6
OnFailure=rackticker-rollback.service

[Service]
Type=simple
User=rackticker
Group=rackticker
WorkingDirectory=/opt/rackticker/current
ExecStart=/opt/rackticker/venv/bin/python -m app --host 0.0.0.0 --port 8081 --config /var/lib/rackticker/config.json --output hub75
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# 512 MB on a Pi 3A+: keep the display inside a budget so a leak or a heavy plugin
# can never take the machine (or ssh) down with it, and let it be killed before
# anything else if memory ever does run out.
MemoryHigh=200M
MemoryMax=280M
OOMScoreAdjust=300
CPUWeight=200
StateDirectory=rackticker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rackticker
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
